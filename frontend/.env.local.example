# Copiá este archivo a .env.local y completá con tus valores reales.
# .env.local está gitignoreado (NO se commitea).

# --- Clerk (crear app dev gratis en https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend FastAPI (borsenhirn/api/main.py) ---
# El dashboard llama GET /me contra esta URL con el JWT de Clerk.
NEXT_PUBLIC_API_URL=http://localhost:8000

# RECORDATORIO: el backend (.env del repo, no este) necesita además:
#   AUTH_VERIFIER=clerk
#   CLERK_ISSUER=https://<tu-frontend-api>.clerk.accounts.dev
#   CLERK_JWKS_URL=https://<tu-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
