# Ejemplo de variables de entorno para Börsenhirn.
# Copia este archivo como .env y rellena los valores. NUNCA commitees el .env real.

# ── Alpaca ──────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
LIVE_ALPACA_API_KEY=
LIVE_ALPACA_SECRET_KEY=

# ── Otras APIs ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_KEY=
FRED_API_KEY=
POLYGON_API_KEY=

# ── Postgres: admin credentials ─────────────────────────────
# Used ONLY by migrations and TenantManager admin lifecycle.
# Runtime code routes through APP_DB_USER below (see Bloque 5 of B1 sprint).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borsenhirn
DB_USER=postgres
DB_PASSWORD=

# ── Postgres: application credentials (B1 multi-tenancy) ────
# Role borsenhirn_app is created by scripts/b1_block5_create_role.sh
# and has NOSUPERUSER + NOBYPASSRLS so RLS policies are enforced.
# Generate the password with: openssl rand -base64 32
# In .env keep these EMPTY to fall back to the admin credentials above
# (single-user dev). In SaaS deploys these MUST be set to the app role.
APP_DB_USER=
APP_DB_PASSWORD=

# ── Alertas: Discord ────────────────────────────────────────
# Obtener en: server settings → Integrations → Webhooks → Create
# IMPORTANTE: pegá el valor SOLO en .env (gitignored), NUNCA aquí.
# Si alguna vez compartiste este URL en chat / prompt / IA, rotalo.
DISCORD_WEBHOOK_URL=

# ── Alertas: Email (SMTP) ───────────────────────────────────
# Para Gmail:
#   1. Activar 2FA en tu cuenta.
#   2. Generar App Password en https://myaccount.google.com/apppasswords
#   3. SMTP_USER = tu_email@gmail.com, SMTP_PASSWORD = app password (16 chars)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Lista separada por comas: destino1@x.com,destino2@y.com
ALERT_EMAIL_TO=

# ── Telegram (opcional, no se usa en esta instalación) ──────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Kill switch (opcional, overrides de defaults) ───────────
KS_MAX_DRAWDOWN_7D_PCT=0.15
KS_MAX_CONSECUTIVE_FAILURES=5

# ── Sanity checks (opcional, overrides de defaults) ─────────
SANITY_MIN_PRICE=0.5
SANITY_MAX_PRICE=100000
SANITY_MAX_QTY_PER_ORDER=10000
SANITY_WASH_GAP_SEC=300
ALERT_DEDUPE_WINDOW_SEC=300

# ── Redis cache (Gap 5) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Secrets vault (Gap 3) ──────────────────────────────────
# Master key Fernet (32 bytes base64-urlsafe). Generar con:
#   python -c "from borsenhirn.security import generate_master_key; print(generate_master_key())"
# IMPORTANTE: si esta key se filtra, todas las credenciales encriptadas
# en user_credentials quedan comprometidas. En producción usá un secrets
# manager (AWS Secrets Manager, Doppler, HashiCorp Vault) en lugar de .env.
BORSENHIRN_MASTER_KEY=
# Solo durante rotación de master key (ver SECRETS.md):
BORSENHIRN_NEW_MASTER_KEY=
# B2: en prod sacá la master key de .env vía un secret provider (ver SECRETS.md):
#   BORSENHIRN_MASTER_KEY_FILE=/run/secrets/borsenhirn_master_key   (Docker/K8s)
#   BORSENHIRN_MASTER_KEY_CMD="doppler secrets get BORSENHIRN_MASTER_KEY --plain"

# ── Auth / Clerk (B3) ───────────────────────────────────────
# Verifier de tokens: 'static' (dev, HS256 con secret propio) o 'clerk' (prod).
AUTH_VERIFIER=static
# Para AUTH_VERIFIER=static (dev/tests): secret HS256 para firmar/verificar.
AUTH_DEV_SECRET=
# Para AUTH_VERIFIER=clerk (prod): datos de tu app Clerk.
#   CLERK_ISSUER   = claim `iss` de tu app (ej. https://<tu-app>.clerk.accounts.dev)
#   CLERK_JWKS_URL = https://<tu-frontend-api>/.well-known/jwks.json
#   CLERK_AUDIENCE = opcional (claim aud/azp)
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
